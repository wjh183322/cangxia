{
  "name": "cangxia-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "藏匣 Windows 本机程序",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test lib/*.test.mjs",
    "pack:win": "electron-builder --win nsis --x64"
  },
  "author": "藏匣",
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cangxia.app",
    "productName": "藏匣",
    "files": ["main.mjs", "preload.cjs", "lib/**"],
    "directories": { "output": "dist-win" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
